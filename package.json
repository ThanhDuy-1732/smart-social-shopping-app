{
  "name": "smart-social-shopping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 14388",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:local": "bash scripts/local-db.sh",
    "admin:grant": "tsx --env-file=.env.local scripts/grant-admin.ts",
    "worker": "tsx --env-file=.env.local src/server/worker.ts",
    "db:backup": "tsx --env-file=.env.local scripts/backup.ts"
  },
  "dependencies": {
    "better-auth": "1.7.25",
    "next": "16.4.6",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
