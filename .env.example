# Copy to .env.local; use a local database only during development.
DATABASE_URL=postgresql://shopping:CHANGE_ME@127.0.0.1:55439/shopping
BETTER_AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32
BETTER_AUTH_URL=http://127.0.0.1:14388
# local writes email to private .local/mail; production requires resend.
MAIL_TRANSPORT=local
RESEND_API_KEY=
MAIL_FROM=
# Optional Web Push: generate VAPID keys; use your real support contact as subject.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Emergency controls: true pauses only new checkout / payout operations.
CHECKOUT_PAUSED=false
PAYOUT_PAUSED=false
# Optional paths to PostgreSQL 18+ client tools for backup/recovery tests.
# PG_DUMP_PATH=/path/to/pg_dump
# PG_RESTORE_PATH=/path/to/pg_restore

# Discovery suggestions: OpenCode Go, model overridable.
OPENCODE_API_KEY=
DISCOVERY_AI_MODEL=deepseek-v4.1-flash
